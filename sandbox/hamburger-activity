<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Build A Hamburger!</title>
<style>
  :root {
    --green: #087c57;                 /* primary */
    --green-dark: #065b40;            /* primary dark */
    --green-deep: #054833;            /* primary deep - text on tinted bg */
    --green-tint: #e5f0ed;            /* primary very pale tint */
    --green-tint-2: #f3f7f6;          /* primary even paler tint */
    --accent: #b3d6cb;                /* accent - lighter partner to primary */
    --ink: #102528;                   /* main body text - neutral */
    --ink-soft: #2c4045;              /* softer body text - neutral */
    --muted: #5a6e71;                 /* muted text - neutral */
    --line: #d8e3e4;                  /* borders - neutral */
    --line-soft: #e8eeef;             /* soft dividers - neutral */
    --bg: #f5f8f8;                    /* page background - neutral */
    --card: #ffffff;                  /* card background - neutral */
    --shadow-sm: 0 1px 2px rgba(5, 72, 51, 0.04), 0 2px 6px rgba(5, 72, 51, 0.05);
    --shadow-md: 0 4px 12px rgba(5, 72, 51, 0.08), 0 12px 32px rgba(5, 72, 51, 0.07);
    --primary-grad: linear-gradient(135deg, #087c57 0%, #065b40 100%);

    /* Ingredient accent colours (decorative only, not part of subject palette) */
    --bun: #e0a545;
    --bun-tint: #fbf1de;
    --patty: #7b4b2a;
    --patty-tint: #f0e5dc;
    --cheese: #e0ab12;
    --cheese-tint: #fdf3d8;
    --lettuce: #4f9a3b;
    --lettuce-tint: #eaf5e6;
    --tomato: #d64526;
    --tomato-tint: #fbe8e2;
    --pickles: #7fa428;
    --pickles-tint: #f1f6e4;
    --mayo: #c9a227;
    --mayo-tint: #fbf6e2;
    --ketchup: #b1272d;
    --ketchup-tint: #fae7e7;

    --green: #087c57; /* restated for clarity */

    --red: #ef4444;
    --red-tint: #fef2f2;
    --amber: #f59e0b;
  }

  * { box-sizing: border-box; }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1rem;
  }

  .header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 2rem;
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: var(--green-tint);
    color: var(--green-deep);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    margin-bottom: 0.9em;
  }

  .header-eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    display: inline-block;
  }

  h1 {
    font-size: 2rem;
    letter-spacing: -0.025em;
    margin: 0 0 0.5em;
    color: var(--ink);
  }

  .header p {
    color: var(--muted);
    font-size: 1.02rem;
    margin: 0;
  }

  .board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .board { grid-template-columns: 1fr; }
  }

  .panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    padding: 1.4rem;
  }

  .panel h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.25em;
  }

  .hint {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 1rem;
  }

  /* Ingredient bank */
  .bank {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 120px;
  }

  .bank.drag-target-active {
    background: var(--green-tint-2);
    border-radius: 10px;
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
  }

  .tile {
    display: flex;
    align-items: center;
    gap: 0.7em;
    width: 100%;
    text-align: left;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 5px solid var(--tile-color, var(--green));
    border-radius: 10px;
    padding: 0.65em 0.9em;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    cursor: grab;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.15s ease, transform 0.15s ease, opacity 0.15s ease;
  }

  .tile:active { cursor: grabbing; }

  .tile:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .tile:focus-visible,
  .slot:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 2px;
  }

  .tile.selected {
    box-shadow: 0 0 0 3px rgba(8, 124, 87, 0.3);
    border-color: var(--green);
  }

  .tile .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--tile-color, var(--green));
    flex-shrink: 0;
  }

  .tile.dragging { opacity: 0.4; }

  .bank-empty-note {
    color: var(--muted);
    font-size: 0.9rem;
    font-style: italic;
    text-align: center;
    padding: 1rem 0;
  }

  /* Burger stack */
  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 200px;
  }

  .slot {
    display: flex;
    align-items: center;
    gap: 0.7em;
    width: 100%;
    min-height: 48px;
    border-radius: 10px;
    padding: 0.6em 0.9em;
    font-size: 0.92rem;
    text-align: left;
    background: var(--card);
    border: 2px dashed var(--line);
    color: var(--muted);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }

  .slot.filled {
    border-style: solid;
    border-color: var(--tile-color, var(--green));
    border-left-width: 6px;
    color: var(--ink);
    font-weight: 500;
    cursor: pointer;
  }

  .slot.drop-hover {
    border-color: var(--green);
    background: var(--green-tint-2);
  }

  .slot.selected {
    box-shadow: 0 0 0 3px rgba(8, 124, 87, 0.3);
    border-color: var(--green) !important;
  }

  .slot[draggable="true"] { cursor: grab; }
  .slot[draggable="true"]:active { cursor: grabbing; }
  .slot.dragging { opacity: 0.4; }

  .slot.correct {
    background: #ecfdf5;
    border-color: #10b981 !important;
  }

  .slot.incorrect {
    background: var(--red-tint);
    border-color: var(--red) !important;
  }

  .slot .swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--tile-color, var(--line));
    flex-shrink: 0;
  }

  .slot .result-icon {
    margin-left: auto;
    font-weight: 700;
  }

  .slot.correct .result-icon { color: #047857; }
  .slot.incorrect .result-icon { color: #b91c1c; }

  .save-note {
    color: var(--muted);
    font-size: 0.82rem;
    font-style: italic;
    margin: 0.9rem 0 0;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.1rem;
    flex-wrap: wrap;
  }

  .hint-box {
    margin-top: 1rem;
    min-height: 6.5em; /* sized to fit the longest hint ("Consider how a chef...") without growing */
    padding: 0.8em 1em;
    border-radius: 10px;
    font-size: 0.92rem;
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--muted);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .hint-box.active {
    background: var(--green-tint-2);
    border-color: var(--accent);
    color: var(--green-deep);
  }

  .hint-box .hint-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.3em;
  }

  .hint-text {
    display: block;
    opacity: 1;
    transition: opacity 6s linear;
  }

  .hint-text.fading { opacity: 0; }

  .hint-box[hidden] { display: none; }

  .hint-box .hint-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.3em;
  }

  button {
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: 10px;
    padding: 0.7rem 1.2rem;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--primary-grad);
    color: #fff;
    box-shadow: 0 4px 12px rgba(8, 124, 87, 0.22);
  }

  .btn-primary:hover { background: linear-gradient(135deg, #065b40 0%, #054833 100%); }

  .btn-secondary {
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .btn-secondary:hover { background: var(--line-soft); }

  .feedback {
    margin-top: 1rem;
    padding: 0.8em 1em;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 500;
    display: none;
  }

  .feedback.show { display: block; }

  .feedback.success {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #10b981;
  }

  .feedback.partial {
    background: #fffbeb;
    color: #b45309;
    border: 1px solid var(--amber);
  }

  .feedback.incomplete {
    background: var(--green-tint-2);
    color: var(--green-deep);
    border: 1px solid var(--accent);
  }

  hr.divider {
    border: none;
    border-top: 1px solid var(--line-soft);
    margin: 2.5rem 0 1.5rem;
  }
</style>
</head>
<body>

<div class="wrap">

  <header class="header">
    <span class="header-eyebrow">Drag &amp; Drop Activity</span>
    <h1>Build A Hamburger!</h1>
    <p>There's a correct way to build the perfect burger. Using the provided resources from class, test your knowledge in building the perfect burger.</p>
  </header>

  <div class="board">

    <section class="panel" aria-labelledby="bank-heading">
      <h2 id="bank-heading">Ingredients</h2>
      <p class="hint">Drag an ingredient onto the stack, or tap an ingredient then tap a layer to place it.</p>
      <div id="bank" class="bank" role="list" aria-label="Ingredient bank"></div>
      <div class="actions">
        <button id="hintBtn" class="btn-secondary" type="button">Get a Hint</button>
      </div>
      <div id="hintBox" class="hint-box" role="status" aria-live="polite">
        <span id="hintLabel" class="hint-label" hidden>Hint</span>
        <span id="hintText" class="hint-text">Click "Get a Hint" above for a tip.</span>
      </div>
    </section>

    <section class="panel" aria-labelledby="stack-heading">
      <h2 id="stack-heading">Your Burger</h2>
      <p class="hint">Layer 1 is the top of the burger, Layer 9 is the bottom.</p>
      <div id="stack" class="stack" role="list" aria-label="Your burger stack"></div>
      <p class="save-note">Your progress isn't saved if you leave or reload this page — this activity is for practice, not for submission.</p>
      <div class="actions">
        <button id="checkBtn" class="btn-primary" type="button">Check Answer</button>
        <button id="resetBtn" class="btn-secondary" type="button">Reset</button>
      </div>
      <div id="feedback" class="feedback" role="status" aria-live="polite"></div>
    </section>

  </div>

  <hr class="divider">

  <footer style="max-width: 1100px; margin: 3rem auto 0; padding: 1.25rem 1.5rem 1rem; border-top: 1px solid #e2e8f0; text-align: center; font-size: 0.78rem; color: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    Created by the School of Education's EdTech Team. For enquiries, contact <a href="mailto:Hum-EdTT@curtin.edu.au" style="color: #64748b; text-decoration: underline;">Hum-EdTT@curtin.edu.au</a>
  </footer>

</div>

<script>
(function () {
  "use strict";

  // Ingredients: 'type' drives the correct-order check; two buns share the type
  // 'bun' but are distinct tiles so both can be dragged out independently.
  var INGREDIENTS = [
    { id: "bun-1",   type: "bun",     label: "Burger Bun",   color: "var(--bun)" },
    { id: "bun-2",   type: "bun",     label: "Burger Bun",   color: "var(--bun)" },
    { id: "ketchup", type: "ketchup", label: "Ketchup",      color: "var(--ketchup)" },
    { id: "pickles", type: "pickles", label: "Pickles",      color: "var(--pickles)" },
    { id: "cheese",  type: "cheese",  label: "Cheese Slice", color: "var(--cheese)" },
    { id: "patty",   type: "patty",   label: "Beef Patty",   color: "var(--patty)" },
    { id: "mayo",    type: "mayo",    label: "Mayo",         color: "var(--mayo)" },
    { id: "tomato",  type: "tomato",  label: "Tomato Slice", color: "var(--tomato)" },
    { id: "lettuce", type: "lettuce", label: "Lettuce",      color: "var(--lettuce)" }
  ];

  // Top of burger (Layer 1) to bottom of burger (Layer 9)
  var CORRECT_ORDER = ["bun", "ketchup", "pickles", "cheese", "patty", "mayo", "tomato", "lettuce", "bun"];

  var HINTS = [
    "Consider how a chef might be able to melt the cheese without using any direct heat.",
    "Avoid adding soggy ingredients directly near the top and bottom bun.",
    "Grease needs to be trapped between ingredients."
  ];

  var bankEl = document.getElementById("bank");
  var stackEl = document.getElementById("stack");
  var feedbackEl = document.getElementById("feedback");
  var checkBtn = document.getElementById("checkBtn");
  var hintBtn = document.getElementById("hintBtn");
  var hintBoxEl = document.getElementById("hintBox");
  var hintLabelEl = document.getElementById("hintLabel");
  var hintTextEl = document.getElementById("hintText");
  var resetBtn = document.getElementById("resetBtn");

  var HINT_PLACEHOLDER = "Click \"Get a Hint\" above for a tip.";

  var selectedTileId = null; // for tap-to-place
  var slots = []; // { index, filled: ingredientId|null }
  var hintTimer = null;

  function byId(id) {
    for (var i = 0; i < INGREDIENTS.length; i++) {
      if (INGREDIENTS[i].id === id) return INGREDIENTS[i];
    }
    return null;
  }

  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  function buildTile(ingredient) {
    var tile = document.createElement("div");
    tile.className = "tile";
    tile.setAttribute("role", "button");
    tile.setAttribute("tabindex", "0");
    tile.setAttribute("draggable", "true");
    tile.setAttribute("data-id", ingredient.id);
    tile.setAttribute("aria-pressed", "false");
    tile.setAttribute("aria-label", ingredient.label + ", draggable ingredient");
    tile.style.setProperty("--tile-color", ingredient.color);

    var swatch = document.createElement("span");
    swatch.className = "swatch";
    tile.appendChild(swatch);

    var label = document.createElement("span");
    label.textContent = ingredient.label;
    tile.appendChild(label);

    tile.addEventListener("dragstart", function (e) {
      tile.classList.add("dragging");
      e.dataTransfer.setData("text/plain", ingredient.id);
      e.dataTransfer.effectAllowed = "move";
    });
    tile.addEventListener("dragend", function () {
      tile.classList.remove("dragging");
    });

    tile.addEventListener("click", function () {
      selectId(ingredient.id);
    });

    tile.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        selectId(ingredient.id);
      } else if (e.key === "Escape") {
        clearSelection();
      }
    });

    return tile;
  }

  function selectId(id) {
    if (selectedTileId === id) {
      clearSelection();
      return;
    }
    selectedTileId = id;
    updateSelectionHighlight();
  }

  function clearSelection() {
    selectedTileId = null;
    updateSelectionHighlight();
  }

  function updateSelectionHighlight() {
    bankEl.querySelectorAll(".tile").forEach(function (el) {
      var isSel = el.getAttribute("data-id") === selectedTileId;
      el.classList.toggle("selected", isSel);
      el.setAttribute("aria-pressed", isSel ? "true" : "false");
    });
    stackEl.querySelectorAll(".slot").forEach(function (el) {
      var idx = parseInt(el.getAttribute("data-index"), 10);
      var isSel = !!selectedTileId && slots[idx] && slots[idx].filled === selectedTileId;
      el.classList.toggle("selected", isSel);
    });
  }

  function lockBankHeight() {
    var placedCount = 0;
    for (var i = 0; i < slots.length; i++) {
      if (slots[i].filled) placedCount++;
    }
    if (placedCount > 0) return; // only (re)lock while the bank holds the full set
    bankEl.style.minHeight = "";
    var h = bankEl.getBoundingClientRect().height;
    bankEl.style.minHeight = h + "px";
  }

  function renderBank() {
    bankEl.innerHTML = "";
    var remaining = INGREDIENTS.filter(function (ing) {
      return !slots.some(function (s) { return s.filled === ing.id; });
    });
    if (remaining.length === 0) {
      var note = document.createElement("p");
      note.className = "bank-empty-note";
      note.textContent = "All ingredients placed. Check your answer!";
      bankEl.appendChild(note);
      return;
    }
    remaining.forEach(function (ing) {
      bankEl.appendChild(buildTile(ing));
    });
    lockBankHeight();
  }

  function buildSlot(index) {
    var slot = document.createElement("div");
    slot.className = "slot";
    slot.setAttribute("role", "button");
    slot.setAttribute("tabindex", "0");
    slot.setAttribute("data-index", index);
    renderSlotContent(slot, index);

    slot.addEventListener("dragover", function (e) {
      e.preventDefault();
      slot.classList.add("drop-hover");
    });
    slot.addEventListener("dragleave", function () {
      slot.classList.remove("drop-hover");
    });
    slot.addEventListener("drop", function (e) {
      e.preventDefault();
      slot.classList.remove("drop-hover");
      var id = e.dataTransfer.getData("text/plain");
      if (id) placeInSlot(id, index);
    });
    slot.addEventListener("dragstart", function (e) {
      var id = slots[index].filled;
      if (!id) { e.preventDefault(); return; }
      slot.classList.add("dragging");
      e.dataTransfer.setData("text/plain", id);
      e.dataTransfer.effectAllowed = "move";
    });
    slot.addEventListener("dragend", function () {
      slot.classList.remove("dragging");
    });

    slot.addEventListener("click", function () {
      handleSlotActivate(index);
    });

    slot.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        handleSlotActivate(index);
      } else if (e.key === "Escape") {
        clearSelection();
      }
    });

    return slot;
  }

  function handleSlotActivate(index) {
    var current = slots[index].filled;
    if (selectedTileId) {
      if (selectedTileId === current) {
        // Tapped the same slot that's already selected — put it back in the bank.
        removeFromSlot(index);
        clearSelection();
      } else {
        placeInSlot(selectedTileId, index);
        clearSelection();
      }
    } else if (current) {
      selectId(current);
    }
  }

  function renderSlotContent(slot, index) {
    var filledId = slots[index].filled;
    slot.classList.remove("correct", "incorrect");
    if (filledId) {
      var ing = byId(filledId);
      slot.classList.add("filled");
      slot.setAttribute("draggable", "true");
      slot.style.setProperty("--tile-color", ing.color);
      slot.innerHTML = "";
      var swatch = document.createElement("span");
      swatch.className = "swatch";
      slot.appendChild(swatch);
      var label = document.createElement("span");
      label.textContent = ing.label;
      slot.appendChild(label);
      slot.setAttribute("aria-label", "Layer " + (index + 1) + ", filled with " + ing.label + ". Activate to pick it up, then activate another layer to move it there, or activate this layer again to return it to the bank. You can also drag it directly.");
    } else {
      slot.classList.remove("filled");
      slot.setAttribute("draggable", "false");
      slot.style.removeProperty("--tile-color");
      slot.textContent = "";
      slot.setAttribute("aria-label", "Layer " + (index + 1) + ", empty. Activate to place the selected ingredient here.");
    }
  }

  function placeInSlot(ingredientId, index) {
    // If ingredient is already in another slot, clear that slot first.
    for (var i = 0; i < slots.length; i++) {
      if (slots[i].filled === ingredientId) slots[i].filled = null;
    }
    // If target slot is occupied, that ingredient returns to the bank.
    slots[index].filled = ingredientId;
    refreshAll();
  }

  function removeFromSlot(index) {
    slots[index].filled = null;
    refreshAll();
  }

  function refreshAll() {
    renderBank();
    var slotEls = stackEl.querySelectorAll(".slot");
    slotEls.forEach(function (el, i) {
      renderSlotContent(el, i);
    });
    updateSelectionHighlight();
    hideFeedback();
  }

  function buildStack() {
    stackEl.innerHTML = "";
    for (var i = 0; i < CORRECT_ORDER.length; i++) {
      stackEl.appendChild(buildSlot(i));
    }
  }

  function hideFeedback() {
    feedbackEl.className = "feedback";
    feedbackEl.textContent = "";
  }

  function checkAnswer() {
    var placedCount = 0;
    var correctCount = 0;
    var slotEls = stackEl.querySelectorAll(".slot");

    slots.forEach(function (s, i) {
      var el = slotEls[i];
      el.classList.remove("correct", "incorrect");
      if (!s.filled) return;
      placedCount++;
      var ing = byId(s.filled);
      if (ing.type === CORRECT_ORDER[i]) {
        el.classList.add("correct");
        correctCount++;
      } else {
        el.classList.add("incorrect");
      }
    });

    feedbackEl.className = "feedback show";
    if (placedCount < CORRECT_ORDER.length) {
      feedbackEl.classList.add("incomplete");
      feedbackEl.textContent = "Place all 9 ingredients before checking your answer. (" + placedCount + " of 9 placed.)";
    } else if (correctCount === CORRECT_ORDER.length) {
      feedbackEl.classList.add("success");
      feedbackEl.textContent = "Perfect burger! All 9 layers are in the correct order.";
    } else {
      feedbackEl.classList.add("partial");
      feedbackEl.textContent = correctCount + " of 9 layers correct. Check the layers highlighted in red and try again.";
    }
  }

  function showHint() {
    clearTimeout(hintTimer);

    var hint = HINTS[Math.floor(Math.random() * HINTS.length)];
    var reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Cancel any in-progress fade instantly before showing the new hint.
    hintTextEl.style.transition = "none";
    hintTextEl.classList.remove("fading");
    hintTextEl.textContent = hint;
    hintLabelEl.hidden = false;
    hintBoxEl.classList.add("active");
    void hintTextEl.offsetWidth; // reflow so the transition below restarts cleanly
    hintTextEl.style.transition = "";

    if (!reducedMotion) {
      requestAnimationFrame(function () {
        hintTextEl.classList.add("fading");
      });
    }

    hintTimer = setTimeout(function () {
      hintTextEl.style.transition = "none";
      hintTextEl.classList.remove("fading");
      hintTextEl.textContent = HINT_PLACEHOLDER;
      hintLabelEl.hidden = true;
      hintBoxEl.classList.remove("active");
      void hintTextEl.offsetWidth;
      hintTextEl.style.transition = "";
    }, 6000);
  }

  function resetActivity() {
    clearTimeout(hintTimer);
    hintTextEl.style.transition = "none";
    hintTextEl.classList.remove("fading");
    hintTextEl.textContent = HINT_PLACEHOLDER;
    hintLabelEl.hidden = true;
    hintBoxEl.classList.remove("active");
    void hintTextEl.offsetWidth;
    hintTextEl.style.transition = "";
    slots = CORRECT_ORDER.map(function () { return { filled: null }; });
    clearSelection();
    refreshAll();
  }

  function init() {
    slots = CORRECT_ORDER.map(function () { return { filled: null }; });
    buildStack();
    renderBank();

    // allow dropping a tile back onto the bank to un-place it
    bankEl.addEventListener("dragover", function (e) {
      e.preventDefault();
      bankEl.classList.add("drag-target-active");
    });
    bankEl.addEventListener("dragleave", function () {
      bankEl.classList.remove("drag-target-active");
    });
    bankEl.addEventListener("drop", function (e) {
      e.preventDefault();
      bankEl.classList.remove("drag-target-active");
      var id = e.dataTransfer.getData("text/plain");
      if (!id) return;
      for (var i = 0; i < slots.length; i++) {
        if (slots[i].filled === id) slots[i].filled = null;
      }
      refreshAll();
    });

    checkBtn.addEventListener("click", checkAnswer);
    hintBtn.addEventListener("click", showHint);
    resetBtn.addEventListener("click", resetActivity);

    window.addEventListener("resize", lockBankHeight);
  }

  // Randomise ingredient tile order once at load (bank display order only —
  // does not affect correctness checking).
  INGREDIENTS = shuffle(INGREDIENTS);

  init();
})();
</script>

